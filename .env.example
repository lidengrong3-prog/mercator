# ============================================================
# JAY观海 环境变量模板（复制为 .env 后填写真实值）
# 注意：真实 .env 已被 .gitignore 排除，绝不可提交仓库
# ============================================================

# ---- Supabase（必填）----
# 项目 URL：Supabase 控制台 → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# 写库用 service_role key（高危凭证，仅放环境变量 / GitHub Secrets，绝不进仓库）
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
# 别名（兼容 migrate_data.py）
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 前端只读 anon / publishable key（可内联于 index.html，需配合 RLS 只读策略）
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- 数据发布兼容模式（默认只写 market_data）----
# 仅当旧版分类表已单独完成 schema 迁移时才设为 1
SUPABASE_SYNC_LEGACY_TABLES=0

# ---- 数据源 API Key（可选，缺失时采集脚本走兜底）----
# 美联储宏观数据（collect_us_macro.py 用 FRED 系列）
FRED_API_KEY=YOUR_FRED_KEY
# 美国人口普查局（Census Bureau）
CENSUS_API_KEY=YOUR_CENSUS_KEY

# ---- AI Edge Function（仅服务端，绝不注入前端）----
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-chat
AI_PROVIDER_TIMEOUT_MS=50000
AI_REQUESTS_PER_MINUTE=20
# 套餐额度来自 billing_plan_entitlements；正整数会作为全局安全上限，0 表示不额外收紧套餐额度
AI_MONTHLY_TOKEN_LIMIT=0
# 按供应商实际价格填写，用于运维成本估算
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0

# ---- 法规中文翻译（服务端数据流水线）----
# 可直接复用 DeepSeek，也可配置任意 OpenAI-compatible chat/completions 服务。
REGULATORY_TRANSLATION_API_URL=https://api.deepseek.com/chat/completions
REGULATORY_TRANSLATION_API_KEY=YOUR_TRANSLATION_SERVICE_KEY
REGULATORY_TRANSLATION_MODEL=deepseek-chat
ALLOWED_ORIGINS=https://lidengrong3-prog.github.io,http://localhost:8000,http://127.0.0.1:8000,http://localhost:4173,http://127.0.0.1:4173

# ---- Stripe 账单基础设施（可选；默认关闭正式收费）----
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# 仅隔离的本地/测试 Supabase 项目可设为 true；生产环境必须保持 false
STRIPE_ALLOW_TEST_EVENTS=false

# ---- 手动加密数据库备份（仅 GitHub Actions Secrets）----
SUPABASE_DB_URL=YOUR_SUPABASE_DATABASE_URL
BACKUP_ENCRYPTION_KEY=YOUR_HIGH_ENTROPY_BACKUP_KEY

# ---- 生产发布与双账号验收（仅 GitHub Environment: production）----
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_CLI_ACCESS_TOKEN
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
PRODUCTION_SITE_URL=https://YOUR_ORG.github.io/YOUR_REPO/
PROD_TEST_USER_A_EMAIL=acceptance-a@example.com
PROD_TEST_USER_A_PASSWORD=YOUR_TEST_PASSWORD_A
PROD_TEST_USER_B_EMAIL=acceptance-b@example.com
PROD_TEST_USER_B_PASSWORD=YOUR_TEST_PASSWORD_B

# ============================================================
# GitHub Actions 中同名 Secrets 已配置：
#   FRED_API_KEY / CENSUS_API_KEY / SUPABASE_URL / SUPABASE_SERVICE_KEY
#   REGULATORY_TRANSLATION_API_URL / REGULATORY_TRANSLATION_API_KEY / REGULATORY_TRANSLATION_MODEL
# 见 .github/workflows/data-update.yml
# ============================================================
